<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.michaelgrundvig.frc</groupId>
  <artifactId>frc-robot-simulation</artifactId>
  <version>2026.10.20</version>
  <name>FRC robot simulation</name>
  <description>The simulated world's physics, the models of the sensors that read it, the errors those sensors make, the catalog of what can go wrong, and the truth suite that checks them.</description>
  <url>https://github.com/mikegrundvig/frc-robot-runtime</url>
  <licenses>
    <license>
      <name>BSD 3-Clause License</name>
      <url>https://github.com/mikegrundvig/frc-robot-runtime/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>mikegrundvig</id>
      <name>Michael Grundvig</name>
      <email>1361573+mikegrundvig@users.noreply.github.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/mikegrundvig/frc-robot-runtime.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/mikegrundvig/frc-robot-runtime.git</developerConnection>
    <url>https://github.com/mikegrundvig/frc-robot-runtime</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>com.michaelgrundvig.frc</groupId>
      <artifactId>frc-robot-model</artifactId>
      <version>2026.10.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
