  <modelVersion>4.0.0</modelVersion>
  <groupId>com.michaelgrundvig.frc</groupId>
  <artifactId>frc-localization</artifactId>
  <version>2026.10.20</version>
  <name>FRC localization</name>
  <description>Where an FRC robot is on the field, from its wheels, its IMUs and its cameras: the localizer contract, two localizers that keep it, the solving of camera images into measurements, and the calibration math.</description>
  <url>https://github.com/mikegrundvig/frc-localization</url>
  <licenses>
    <license>
      <name>BSD 3-Clause License</name>
      <url>https://github.com/mikegrundvig/frc-localization/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>mikegrundvig</id>
      <name>Michael Grundvig</name>
      <email>1361573+mikegrundvig@users.noreply.github.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/mikegrundvig/frc-localization.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/mikegrundvig/frc-localization.git</developerConnection>
    <url>https://github.com/mikegrundvig/frc-localization</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>com.michaelgrundvig.frc</groupId>
      <artifactId>frc-robot-model</artifactId>
      <version>2026.10.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>compile</scope>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>compile</scope>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
